---
import Bloom from './Bloom.astro';
import Icon from './Icon.astro';
import { products } from '../data/site';
---

<section id="products" class="relative bg-sand/60 py-24 lg:py-32">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow text-rose" data-reveal>Our flowers</p>
        <h2 class="display mt-5 text-4xl leading-[1.05] sm:text-5xl" data-reveal>A portfolio of 160+ varieties, grown to programme.</h2>
      </div>
      <p class="max-w-md text-ink/65" data-reveal>Each line is graded to European auction standards and packed to your specification, from auction buckets to retail-ready sleeves.</p>
    </div>

    <div class="mt-16 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {products.map((p, i) => (
        <article class="group relative flex flex-col overflow-hidden rounded-3xl bg-white shadow-[0_1px_0_rgba(8,32,26,0.06)] transition duration-500 ease-out-expo hover:-translate-y-1.5 hover:shadow-[0_30px_60px_-30px_rgba(8,32,26,0.35)]" data-reveal style={`--delay:${i * 90}ms`}>
          <div class="relative grid aspect-[4/3.4] place-items-center overflow-hidden" style={`background: radial-gradient(120% 90% at 50% 100%, ${p.palette[2]}55, transparent 60%), #f3ede3`}>
            <Bloom palette={p.palette} seed={i + 1} size={220} class="h-[72%] w-[72%] transition duration-[1.4s] ease-out-expo group-hover:scale-110 group-hover:rotate-12" />
            <span class="absolute top-4 left-4 rounded-full bg-white/80 px-3 py-1 text-[0.68rem] font-semibold tracking-[0.12em] text-ink/70 uppercase backdrop-blur">{p.category}</span>
            <span class="absolute top-4 right-4 text-xs font-medium text-ink/50">{p.varieties} varieties</span>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h3 class="display text-2xl">{p.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/65">{p.description}</p>
            <dl class="mt-6 space-y-2 border-t border-ink/8 pt-5 text-sm">
              {p.specs.map((s) => (
                <div class="flex justify-between gap-4">
                  <dt class="text-ink/50">{s.label}</dt>
                  <dd class="font-medium">{s.value}</dd>
                </div>
              ))}
            </dl>
            <a href="#quote" class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold text-rose">
              Request availability <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
