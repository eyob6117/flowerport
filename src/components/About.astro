---
import { stats, farmRegions } from '../data/site';
---

<section id="about" class="relative py-24 lg:py-32">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow text-rose" data-reveal>Who we are</p>
        <h2 class="display mt-5 text-4xl leading-[1.05] sm:text-5xl" data-reveal>
          The road link in Ethiopia’s <em class="italic">cold chain</em>.
        </h2>
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-ink/70 lg:col-span-6 lg:col-start-7" data-reveal style="--delay:100ms">
        <p>
          Flowerport Transport focuses on road transportation within Ethiopia. Our customers are flower farms, meat exporters, vegetable growers and others whose product quality depends on fresh, timely delivery.
        </p>
        <p>
          We offer a complete service package: our inland transport links with a global network to meet our clients’ needs in an economic and cost-efficient way. Today we carry around 60% of Ethiopia’s flower exports from the farms to the airport, and we are a preferred distributor for large multinational companies.
        </p>
        <div class="pt-2">
          <p class="text-xs font-semibold tracking-[0.14em] text-ink/45 uppercase">Farm regions we connect to Bole</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {farmRegions.map((f) => (
              <li class="rounded-full border border-ink/10 bg-white px-3.5 py-1.5 text-sm text-ink/70">{f}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <dl class="mt-20 grid gap-px overflow-hidden rounded-3xl border border-ink/8 bg-ink/8 sm:grid-cols-2 lg:grid-cols-4">
      {stats.map((s, i) => (
        <div class="bg-cream p-8 lg:p-10" data-reveal style={`--delay:${i * 80}ms`}>
          <dd class="display text-5xl whitespace-nowrap text-ink xl:text-6xl">
            <span data-count={s.value}>{s.value}</span><span class="text-rose">{s.suffix}</span>
          </dd>
          <dt class="mt-4 max-w-[16rem] text-sm leading-relaxed text-ink/60">{s.label}</dt>
        </div>
      ))}
    </dl>
  </div>
</section>
