---
import Icon from './Icon.astro';
import { sustainability } from '../data/site';
const C = 2 * Math.PI * 52;
const commitments = [
  { icon: 'drop', title: 'Closed-loop water', body: 'Rainwater harvesting, drip fertigation and constructed wetlands treat and reuse irrigation water.' },
  { icon: 'leaf', title: 'Biological crop protection', body: 'Beneficial insects and integrated pest management replace the large majority of chemical sprays.' },
  { icon: 'users', title: 'People & communities', body: 'Living-wage benchmarking, on-site clinics, childcare and schools serving our farm communities.' },
] as const;
---

<section id="sustainability" class="relative py-24 lg:py-32">
  <div class="container-x">
    <div class="overflow-hidden rounded-[2rem] bg-mist">
      <div class="grid lg:grid-cols-12">
        <div class="p-8 sm:p-12 lg:col-span-7 lg:p-16">
          <p class="eyebrow text-forest" data-reveal>Sustainability</p>
          <h2 class="display mt-5 text-4xl leading-[1.05] text-forest sm:text-5xl" data-reveal>Beautiful flowers, grown responsibly.</h2>
          <p class="mt-6 max-w-xl text-forest/70" data-reveal>Responsible production is not a label we add at the end. It is designed into our farms, our packaging and the way we treat the 7,400 people who grow our flowers.</p>
          <div class="mt-12 grid gap-8 sm:grid-cols-3">
            {commitments.map((c, i) => (
              <div data-reveal style={`--delay:${i * 80}ms`}>
                <Icon name={c.icon} class="h-6 w-6 text-forest" />
                <h3 class="mt-4 font-semibold text-forest">{c.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-forest/65">{c.body}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="grid content-center gap-8 bg-forest p-8 text-cream sm:grid-cols-3 sm:p-12 lg:col-span-5 lg:grid-cols-1 lg:p-16">
          {sustainability.map((s, i) => (
            <div class="flex items-center gap-6" data-reveal style={`--delay:${i * 100}ms`}>
              <svg viewBox="0 0 120 120" class="h-24 w-24 shrink-0 -rotate-90" aria-hidden="true">
                <circle cx="60" cy="60" r="52" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="8" />
                <circle cx="60" cy="60" r="52" fill="none" stroke="#d6a645" stroke-width="8" stroke-linecap="round" stroke-dasharray={`${(C * s.value) / 100} ${C}`} />
              </svg>
              <div>
                <p class="display text-4xl"><span data-count={s.value}>{s.value}</span>{s.unit}</p>
                <p class="mt-1 text-sm text-cream/65">{s.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
