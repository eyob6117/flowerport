---
import Icon from './Icon.astro';
import { advantages } from '../data/site';
const icons = ['sun', 'plane', 'globe', 'chart'] as const;
---

<section class="relative bg-sand/60 py-24 lg:py-32">
  <div class="container-x grid gap-14 lg:grid-cols-12">
    <div class="lg:sticky lg:top-32 lg:col-span-5 lg:self-start">
      <p class="eyebrow text-rose" data-reveal>Why Ethiopia</p>
      <h2 class="display mt-5 text-4xl leading-[1.05] sm:text-5xl" data-reveal>Nature’s greenhouse, at the crossroads of global trade.</h2>
      <p class="mt-6 text-ink/65" data-reveal>Ethiopia is one of the world’s leading flower exporters. Its high-altitude climate and strategic location give buyers a rare combination of quality, consistency and speed.</p>
      <div class="mt-10 overflow-hidden rounded-3xl bg-ink p-8 text-cream" data-reveal>
        <div class="flex items-end gap-3">
          <span class="display text-6xl text-ochre">#1</span>
          <span class="pb-2 text-sm text-cream/60">Ethiopian Airlines Cargo,<br />Africa’s largest cargo carrier</span>
        </div>
        <div class="mt-6 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
          <div class="h-full w-4/5 rounded-full bg-gradient-to-r from-ochre to-rose"></div>
        </div>
        <p class="mt-3 text-xs text-cream/45">Dedicated perishables terminal at Addis Ababa Bole International Airport</p>
      </div>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
      {advantages.map((a, i) => (
        <div class={`card p-8 ${i % 2 === 1 ? 'sm:mt-12' : ''}`} data-reveal style={`--delay:${i * 80}ms`}>
          <div class="grid h-12 w-12 place-items-center rounded-2xl bg-rose/10 text-rose"><Icon name={icons[i]} class="h-6 w-6" /></div>
          <h3 class="mt-6 text-xl font-semibold">{a.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/65">{a.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
