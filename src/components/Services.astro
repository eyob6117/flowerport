---
import Icon from './Icon.astro';
import { services } from '../data/site';
---

<section id="services" class="relative bg-sand/60 py-24 lg:py-32">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow text-rose" data-reveal>What we do</p>
        <h2 class="display mt-5 text-4xl leading-[1.05] sm:text-5xl" data-reveal>A complete service package for perishable cargo.</h2>
      </div>
      <p class="max-w-md text-ink/65" data-reveal>From the farm gate to the cargo terminal and from the airport to your door, one carrier handles your temperature-sensitive goods end to end.</p>
    </div>

    <div class="mt-16 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {services.map((sv, i) => (
        <article class="group relative flex flex-col overflow-hidden rounded-3xl bg-white p-7 shadow-[0_1px_0_rgba(8,32,26,0.06)] transition duration-500 ease-out-expo hover:-translate-y-1.5 hover:shadow-[0_30px_60px_-30px_rgba(8,32,26,0.35)]" data-reveal style={`--delay:${i * 90}ms`}>
          <div class="flex items-center justify-between">
            <span class="grid h-14 w-14 place-items-center rounded-2xl bg-rose/10 text-rose transition duration-500 group-hover:bg-rose group-hover:text-white"><Icon name={sv.icon} class="h-7 w-7" /></span>
            <span class="font-display text-sm text-ink/35">0{i + 1}</span>
          </div>
          <h3 class="display mt-8 text-2xl leading-tight">{sv.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/65">{sv.body}</p>
          <ul class="mt-6 space-y-2.5 border-t border-ink/8 pt-5 text-sm text-ink/75">
            {sv.points.map((p) => <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 shrink-0 text-leaf" />{p}</li>)}
          </ul>
          <a href="#quote" class="mt-auto inline-flex items-center gap-2 pt-7 text-sm font-semibold text-rose">
            Request this service <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
