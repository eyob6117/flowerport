---
import Icon from './Icon.astro';
import { solutions, testimonials } from '../data/site';
---

<section id="solutions" class="relative bg-ink py-24 text-cream lg:py-32">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow text-blush" data-reveal>Who we partner with</p>
      <h2 class="display mt-5 text-4xl leading-[1.05] sm:text-5xl" data-reveal>Supply programmes built around how you sell.</h2>
    </div>
    <div class="mt-16 grid gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 md:grid-cols-2 xl:grid-cols-4">
      {solutions.map((s, i) => (
        <div class="group flex flex-col bg-ink p-8 transition duration-500 hover:bg-forest" data-reveal style={`--delay:${i * 80}ms`}>
          <span class="font-display text-sm text-rose">0{i + 1}</span>
          <h3 class="mt-10 text-2xl font-semibold">{s.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-cream/60">{s.body}</p>
          <ul class="mt-8 space-y-2.5 text-sm text-cream/80">
            {s.points.map((p) => <li class="flex items-center gap-2.5"><Icon name="check" class="h-4 w-4 text-rose" />{p}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-24 grid gap-6 lg:grid-cols-3">
      {testimonials.map((t, i) => (
        <figure class="flex flex-col rounded-3xl border border-white/10 bg-white/[0.03] p-8" data-reveal style={`--delay:${i * 80}ms`}>
          <Icon name="quote" class="h-8 w-8 text-rose" />
          <blockquote class="mt-6 flex-1 font-display text-xl leading-snug text-cream/90">“{t.quote}”</blockquote>
          <figcaption class="mt-8 border-t border-white/10 pt-5 text-sm">
            <p class="font-semibold">{t.name}</p>
            <p class="text-cream/50">{t.company}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
