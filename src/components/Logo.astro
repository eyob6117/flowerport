---
import Mark from './Mark.astro';
interface Props { class?: string; tone?: 'light' | 'dark' }
const { class: className, tone = 'dark' } = Astro.props;
const word = tone === 'light' ? '#f8f4ec' : '#7b2a63';
const sub = tone === 'light' ? '#c9dcc0' : '#4f7f33';
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <Mark class="h-10 w-10 shrink-0" />
  <span class="leading-none">
    <span class="block font-display text-[1.45rem] tracking-tight" style={`color:${word}`}>Flowerport</span>
    <span class="mt-1 block text-[0.6rem] font-semibold tracking-[0.34em] uppercase" style={`color:${sub}`}>Transport</span>
  </span>
</span>
