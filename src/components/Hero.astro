---
import Bloom from './Bloom.astro';
import Icon from './Icon.astro';
import { heroStats, certifications } from '../data/site';
---

<section id="top" class="grain relative isolate overflow-hidden bg-ink pt-[76px] text-cream lg:pt-[112px]">
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="absolute -top-40 right-[-10%] h-[720px] w-[720px] rounded-full bg-rose/25 blur-[140px]"></div>
    <div class="absolute bottom-[-20%] left-[-10%] h-[520px] w-[520px] rounded-full bg-moss/70 blur-[120px]"></div>
    <svg class="absolute inset-0 h-full w-full opacity-[0.07]" aria-hidden="true">
      <defs><pattern id="grid" width="64" height="64" patternUnits="userSpaceOnUse"><path d="M64 0H0V64" fill="none" stroke="#fff" stroke-width="1" /></pattern></defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>
  </div>

  <div class="container-x grid items-center gap-14 pt-12 pb-16 lg:grid-cols-12 lg:gap-8 lg:pt-16 lg:pb-24">
    <div class="lg:col-span-7">
      <p class="eyebrow text-blush" data-reveal>Grown at 2,600 m · Shipped worldwide</p>
      <h1 class="display mt-6 text-[clamp(2.6rem,5.2vw,4.6rem)] leading-[1.02]" data-reveal style="--delay:80ms">
        From the Ethiopian highlands to the world’s <em class="text-rose italic">flower markets</em>, in under 48 hours.
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-cream/70" data-reveal style="--delay:160ms">
        Flower Port grows, grades and exports premium roses and summer flowers for importers, auctions and retailers in 42 countries, backed by an unbroken, fully logged cold chain.
      </p>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--delay:240ms">
        <a href="#quote" class="btn-primary">Request a quote <Icon name="arrow" class="h-4 w-4" /></a>
        <a href="#products" class="btn-ghost-light">Explore our flowers</a>
      </div>
      <dl class="mt-14 grid max-w-xl grid-cols-3 gap-6 border-t border-white/10 pt-8" data-reveal style="--delay:320ms">
        {heroStats.map((s) => (
          <div>
            <dt class="text-xs leading-snug text-cream/55">{s.label}</dt>
            <dd class="display order-first text-3xl sm:text-4xl">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="relative mx-auto aspect-square w-full max-w-[560px] lg:col-span-5" data-reveal style="--delay:200ms">
      <div class="absolute inset-[6%] rounded-full border border-white/10"></div>
      <div class="absolute inset-[18%] rounded-full border border-dashed border-white/10 motion-safe:animate-[spin_90s_linear_infinite]"></div>
      <Bloom palette={['#7f1230', '#d8375c', '#ffb3c1']} seed={3} size={560} class="absolute inset-[8%] h-[84%] w-[84%] drop-shadow-[0_40px_60px_rgba(0,0,0,0.45)] motion-safe:animate-[spin_160s_linear_infinite]" />
      <Bloom palette={['#b45309', '#f59e0b', '#fde68a']} seed={5} size={200} class="absolute -bottom-2 left-[-4%] h-[34%] w-[34%] drop-shadow-2xl motion-safe:animate-[spin_120s_linear_infinite_reverse]" />
      <Bloom palette={['#9d174d', '#f472b6', '#fce7f3']} seed={2} size={160} class="absolute top-[2%] right-[2%] h-[24%] w-[24%] drop-shadow-2xl motion-safe:animate-[spin_100s_linear_infinite]" />

      <div class="absolute right-[-2%] bottom-[10%] w-[min(290px,78%)] rounded-2xl border border-white/15 bg-ink/60 p-4 shadow-2xl backdrop-blur-xl sm:right-[-6%]">
        <div class="flex items-center justify-between text-[0.68rem] tracking-[0.14em] text-cream/50 uppercase">
          <span>Shipment FP-24817</span>
          <span class="flex items-center gap-1.5 text-emerald-300"><span class="h-1.5 w-1.5 rounded-full bg-emerald-300"></span>In transit</span>
        </div>
        <div class="mt-3 flex items-center justify-between font-display text-2xl">
          <span>ADD</span>
          <span class="relative mx-3 h-px flex-1 bg-white/20">
            <span class="absolute top-1/2 left-[62%] -translate-y-1/2 text-rose"><Icon name="plane" class="h-4 w-4 rotate-45" /></span>
          </span>
          <span>AMS</span>
        </div>
        <div class="mt-3 grid grid-cols-3 gap-2 text-[0.7rem] text-cream/55">
          <div><p class="text-sm font-semibold text-cream">2.4°C</p>Hold temp</div>
          <div><p class="text-sm font-semibold text-cream">1,240</p>Boxes</div>
          <div><p class="text-sm font-semibold text-cream">06:10</p>ETA local</div>
        </div>
      </div>
      <div class="absolute top-[14%] left-[-4%] hidden rounded-2xl border border-white/15 bg-white/10 px-4 py-3 shadow-xl backdrop-blur-xl sm:block">
        <p class="text-[0.66rem] tracking-[0.14em] text-cream/55 uppercase">Vase life tested</p>
        <p class="display text-2xl">14 days</p>
      </div>
    </div>
  </div>

  <div class="relative border-t border-white/10 py-6">
    <div class="container-x flex items-center gap-8">
      <p class="hidden shrink-0 text-xs font-medium tracking-[0.14em] text-cream/45 uppercase md:block">Certified & audited</p>
      <div class="relative overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_10%,#000_90%,transparent)]">
        <ul class="flex w-max animate-marquee gap-12 pr-12 text-sm font-semibold tracking-wide text-cream/65">
          {[...certifications, ...certifications].map((c, i) => (
            <li class="flex items-center gap-3 whitespace-nowrap" aria-hidden={i >= certifications.length ? 'true' : undefined}>
              <Icon name="shield" class="h-4 w-4 text-rose" />{c}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
