---
// Looping animated hero scene: a Flower Port reefer truck driving through the Ethiopian highlands.
// The truck stays in frame while the road, farms and mountains scroll past at different speeds.
import Bloom from './Bloom.astro';

interface Props { class?: string }
const { class: className } = Astro.props;

const W = 1600; // one loop period in scene units; every scrolling layer tiles at this width

// Deterministic pseudo-random so builds are reproducible
let s = 7;
const rand = () => ((s = (s * 9301 + 49297) % 233280) / 233280);

/** A ridge line that starts and ends at the same height so two copies tile seamlessly. */
function ridge(base: number, amp: number, step: number) {
  const pts: [number, number][] = [];
  const start = base - rand() * amp;
  for (let x = 0; x <= W; x += step) {
    pts.push([x, x === 0 || x === W ? start : base - rand() * amp]);
  }
  let d = `M0 500 L0 ${pts[0][1].toFixed(1)}`;
  for (let i = 1; i < pts.length; i++) {
    const [px, py] = pts[i - 1];
    const [x, y] = pts[i];
    const cx = (px + x) / 2;
    d += ` C${cx.toFixed(1)} ${py.toFixed(1)} ${cx.toFixed(1)} ${y.toFixed(1)} ${x} ${y.toFixed(1)}`;
  }
  return d + ` L${W} 500 Z`;
}

const far = ridge(250, 120, 200);
const mid = ridge(330, 60, 160);

// Greenhouse clusters on the mid hills: a nod to the farms the flowers come from
const greenhouses = [120, 520, 980, 1340].map((x, i) => ({ x, y: 318 + (i % 2) * 8, n: 3 + (i % 3) }));
// Roadside acacias and poles on the near layer
const acacias = [180, 760, 1290];
const poles = [0, 400, 800, 1200];

const wheel = (cx: number) => ({ cx, cy: 398 });
const wheels = [640, 712, 784, 1318, 1424].map(wheel);
---

<div class:list={['truck-scene pointer-events-none select-none', className]} aria-hidden="true">
  <svg viewBox="0 0 2000 500" preserveAspectRatio="xMaxYMax slice" class="h-full w-full">
    <defs>
      <linearGradient id="ts-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#08201a" stop-opacity="0" />
        <stop offset=".55" stop-color="#d8375c" stop-opacity=".18" />
        <stop offset=".8" stop-color="#d6a645" stop-opacity=".22" />
        <stop offset="1" stop-color="#08201a" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="ts-trailer" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffffff" />
        <stop offset=".7" stop-color="#f8f4ec" />
        <stop offset="1" stop-color="#e4dccd" />
      </linearGradient>
      <linearGradient id="ts-cab" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1d4a3c" />
        <stop offset="1" stop-color="#0b2a22" />
      </linearGradient>
      <linearGradient id="ts-glass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#9cc3b4" stop-opacity=".9" />
        <stop offset=".5" stop-color="#2f5d50" />
        <stop offset="1" stop-color="#0b2a22" />
      </linearGradient>
      <linearGradient id="ts-beam" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff6d6" stop-opacity=".55" />
        <stop offset="1" stop-color="#fff6d6" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="ts-road" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#14231f" />
        <stop offset="1" stop-color="#050f0c" />
      </linearGradient>
      <clipPath id="ts-trailer-clip"><rect x="560" y="168" width="704" height="206" rx="10" /></clipPath>
    </defs>

    <rect width="2000" height="420" fill="url(#ts-sky)" />
    <circle cx="1820" cy="240" r="70" fill="#d6a645" opacity=".18" />

    <!-- Far highlands -->
    <g class="ts-layer ts-far">
      <path d={far} fill="#16392f" opacity=".85" />
      <path d={far} fill="#16392f" opacity=".85" transform={`translate(${W} 0)`} />
      <path d={far} fill="#16392f" opacity=".85" transform={`translate(${W * 2} 0)`} />
    </g>

    <!-- Mid hills with greenhouse farms -->
    <g class="ts-layer ts-mid">
      {[0, W, W * 2].map((ox) => (
        <g transform={`translate(${ox} 0)`}>
          <path d={mid} fill="#0f3329" />
          {greenhouses.map((g) => (
            <g transform={`translate(${g.x} ${g.y})`} opacity=".55">
              {Array.from({ length: g.n }, (_, i) => (
                <path d={`M${i * 34} 0 q17 -16 34 0 z`} fill="#dfe9e3" />
              ))}
            </g>
          ))}
        </g>
      ))}
    </g>

    <!-- Roadside -->
    <g class="ts-layer ts-near">
      {[0, W, W * 2].map((ox) => (
        <g transform={`translate(${ox} 0)`}>
          <rect x="0" y="404" width={W} height="16" fill="#0a2019" />
          {acacias.map((x) => (
            <g transform={`translate(${x} 406)`} fill="#06150f">
              <path d="M-3 0 L-2 -46 L-18 -60 L-14 -62 L0 -52 L14 -64 L18 -62 L3 -48 L3 0 Z" />
              <ellipse cx="0" cy="-66" rx="62" ry="12" />
              <ellipse cx="-20" cy="-74" rx="30" ry="8" />
              <ellipse cx="24" cy="-73" rx="28" ry="8" />
            </g>
          ))}
          {poles.map((x) => (
            <g transform={`translate(${x + 300} 406)`} stroke="#06150f" stroke-width="4">
              <line x1="0" y1="0" x2="0" y2="-120" />
              <line x1="-16" y1="-108" x2="16" y2="-108" />
            </g>
          ))}
          <path d="M300 298 Q500 312 700 298 T1100 298 T1500 298 T1900 298" fill="none" stroke="#06150f" stroke-width="1.2" />
        </g>
      ))}
    </g>

    <!-- Road -->
    <rect x="0" y="418" width="2000" height="82" fill="url(#ts-road)" />
    <rect x="0" y="418" width="2000" height="3" fill="#2a3d37" />
    <g class="ts-layer ts-road">
      {Array.from({ length: 14 }, (_, i) => (
        <rect x={i * 160} y="462" width="80" height="5" rx="2.5" fill="#f8f4ec" opacity=".55" />
      ))}
    </g>

    <!-- Truck -->
    <g transform="translate(420 0)">
    <ellipse cx="1010" cy="432" rx="500" ry="14" fill="#000" opacity=".5" />
    <polygon points="1478,352 1600,318 1600,430 1478,372" fill="url(#ts-beam)" />

    <g class="ts-truck">
      <!-- chassis -->
      <rect x="566" y="372" width="900" height="14" rx="3" fill="#0b1512" />
      <rect x="600" y="384" width="220" height="10" fill="#0b1512" />

      <!-- reefer trailer -->
      <rect x="560" y="168" width="704" height="206" rx="10" fill="url(#ts-trailer)" />
      <g clip-path="url(#ts-trailer-clip)">
        <rect x="560" y="344" width="704" height="30" fill="#d8375c" />
        <rect x="560" y="338" width="704" height="4" fill="#d6a645" />
        <g transform="translate(470 108)" opacity=".95"><Bloom palette={['#a8203f', '#d8375c', '#f7d7de']} size={260} seed={4} /></g>
        <g transform="translate(600 270)" opacity=".9"><Bloom palette={['#b45309', '#f59e0b', '#fde68a']} size={120} seed={6} /></g>
        {Array.from({ length: 9 }, (_, i) => (
          <line x1={560 + (i + 1) * 70} y1="168" x2={560 + (i + 1) * 70} y2="338" stroke="#08201a" stroke-opacity=".05" stroke-width="2" />
        ))}
      </g>
      <g transform="translate(790 214)">
        <circle cx="26" cy="26" r="26" fill="#d8375c" />
        <path d="M26 10c5.3 4 8 8.7 8 14S30.4 34 26 35.3C21.6 34 18 29.3 18 24s2.7-10 8-14Z" fill="#f8f4ec" />
        <path d="M26 35.3c-6.6-1.3-12.6-5.3-14.6-11.3 5.6-.8 11.2 2.1 14.6 6.9 3.4-4.8 9-7.7 14.6-6.9-2 6-8 10-14.6 11.3Z" fill="#f7d7de" />
        <text x="66" y="40" font-family="Fraunces Variable, Georgia, serif" font-size="50" fill="#08201a" letter-spacing="-1">Flower Port</text>
        <text x="68" y="74" font-family="Inter Variable, sans-serif" font-size="13" font-weight="700" fill="#08201a" fill-opacity=".6" letter-spacing="3.5">HIGHLAND FLOWERS · WORLDWIDE</text>
        <g transform="translate(68 90)" font-family="Inter Variable, sans-serif" font-weight="700" font-size="12">
          <rect width="136" height="26" rx="13" fill="#08201a" />
          <text x="68" y="17" text-anchor="middle" fill="#f8f4ec" letter-spacing="1.5">COLD CHAIN 2°C</text>
          <text x="150" y="17" fill="#08201a" fill-opacity=".55" letter-spacing="1.5">ADDIS ABABA · ETHIOPIA</text>
        </g>
      </g>
      <!-- reefer unit -->
      <rect x="1262" y="186" width="26" height="118" rx="5" fill="#cfd8d3" />
      {[0, 1, 2, 3, 4].map((i) => <rect x="1267" y={198 + i * 20} width="16" height="10" rx="2" fill="#7c8a84" />)}

      <!-- cab (cab-over, facing right) -->
      <path d="M1290 160 h132 q22 0 30 20 l18 64 q4 14 4 30 v86 q0 12 -12 12 h-172 z" fill="url(#ts-cab)" />
      <path d="M1360 176 h58 q14 0 19 13 l16 52 q2 8 -6 8 h-87 z" fill="url(#ts-glass)" />
      <path d="M1300 176 h48 v73 h-48 z" fill="url(#ts-glass)" opacity=".7" />
      <rect x="1290" y="300" width="186" height="8" fill="#d8375c" />
      <rect x="1290" y="308" width="186" height="2.5" fill="#d6a645" />
      <text x="1330" y="290" font-family="Fraunces Variable, Georgia, serif" font-size="26" fill="#f8f4ec">FP</text>
      <rect x="1456" y="318" width="20" height="16" rx="3" fill="#fff6d6" />
      <rect x="1452" y="342" width="24" height="26" rx="3" fill="#08201a" />
      {[0, 1, 2].map((i) => <rect x="1455" y={346 + i * 7} width="18" height="3" fill="#2a3d37" />)}
      <rect x="1440" y="196" width="10" height="34" rx="3" fill="#0b1512" />
      <rect x="1290" y="252" width="140" height="2" fill="#000" opacity=".25" />

      <!-- wheels -->
      {wheels.map((w) => (
        <g transform={`translate(${w.cx} ${w.cy})`}>
          <circle r="32" fill="#070d0b" />
          <circle r="19" fill="#3a4743" />
          <g class="ts-wheel">
            {[0, 60, 120].map((a) => <rect x="-17" y="-2.5" width="34" height="5" rx="2" fill="#8a9893" transform={`rotate(${a})`} />)}
          </g>
          <circle r="5" fill="#cfd8d3" />
        </g>
      ))}
      <path d="M1286 362 h68 q-6 -40 -36 -40 q-30 0 -32 40z" fill="#0b2a22" />
      <path d="M1390 362 h68 q-4 -40 -34 -40 q-30 0 -34 40z" fill="#0b2a22" />
    </g>
    </g>
  </svg>
</div>

<style>
  .ts-layer { will-change: transform; animation: ts-scroll linear infinite; }
  .ts-far { animation-duration: 90s; }
  .ts-mid { animation-duration: 40s; }
  .ts-near { animation-duration: 9s; }
  .ts-road { animation: ts-road 0.6s linear infinite; }
  .ts-truck { animation: ts-bump 0.9s ease-in-out infinite; }
  .ts-wheel { animation: ts-spin 0.45s linear infinite; }

  @keyframes ts-scroll { to { transform: translateX(-1600px); } }
  @keyframes ts-road { to { transform: translateX(-160px); } }
  @keyframes ts-spin { to { transform: rotate(360deg); } }
  @keyframes ts-bump {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(1.2px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ts-layer, .ts-road, .ts-truck, .ts-wheel { animation: none; }
  }
</style>
