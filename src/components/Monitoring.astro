---
import Icon from './Icon.astro';
const features = [
  { icon: 'route', title: 'Live location', body: 'Every truck is tracked on the road, so dispatch always knows where your cargo is.' },
  { icon: 'thermo', title: 'Temperature control', body: 'Reefer temperatures are monitored throughout the run to protect the cold chain.' },
  { icon: 'bell', title: 'Instant alerts', body: 'Deviations in temperature, route or timing are flagged so the team can act at once.' },
  { icon: 'chart', title: 'Delivery records', body: 'Each run leaves a record of times and conditions for your quality and compliance teams.' },
] as const;

// Illustrative readings for the dashboard mock-up
const temps = [3.1, 3.0, 2.9, 3.2, 3.4, 3.1, 2.8, 2.9, 3.0, 3.3, 3.2, 3.0, 2.9, 3.1, 3.0, 2.9, 3.2, 3.1, 3.0, 3.0];
const W = 360, H = 90, min = 1, max = 5;
const line = temps.map((t, i) => `${i ? 'L' : 'M'}${((i / (temps.length - 1)) * W).toFixed(1)} ${(H - ((t - min) / (max - min)) * H).toFixed(1)}`).join(' ');
const band = (t: number) => (H - ((t - min) / (max - min)) * H).toFixed(1);
const fleet = [
  { id: 'FP-RF 112', route: 'Holeta → Bole', temp: '3.0°C', eta: '42 min', ok: true },
  { id: 'FP-RF 087', route: 'Ziway → Bole', temp: '2.8°C', eta: '1 h 55', ok: true },
  { id: 'FP-RF 140', route: 'Bishoftu → Bole', temp: '3.3°C', eta: '18 min', ok: true },
  { id: 'FP-RF 064', route: 'Bole → Sebeta', temp: '4.6°C', eta: '25 min', ok: false },
];
---

<section id="monitoring" class="relative overflow-hidden py-24 lg:py-32">
  <div class="container-x grid items-center gap-14 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="eyebrow text-rose" data-reveal>Fleet monitoring</p>
      <h2 class="display mt-5 text-4xl leading-[1.05] sm:text-5xl" data-reveal>A modern, monitored and controlled fleet.</h2>
      <p class="mt-6 text-ink/65" data-reveal>Flowerport maintains a modern, automated monitoring and control system for its expanding fleet of trucks, giving clients speedy, efficient service without compromising safety or quality.</p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {features.map((f, i) => (
          <div data-reveal style={`--delay:${i * 70}ms`}>
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-leaf/15 text-forest"><Icon name={f.icon} class="h-5 w-5" /></span>
            <h3 class="mt-4 font-semibold">{f.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink/60">{f.body}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="lg:col-span-7" data-reveal style="--delay:120ms">
      <div class="rounded-[2rem] bg-ink p-3 shadow-[0_40px_80px_-40px_rgba(8,32,26,0.6)]">
        <div class="rounded-[1.6rem] border border-white/10 bg-forest p-5 text-cream sm:p-7">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="h-2.5 w-2.5 rounded-full bg-leaf"></span>
              <p class="text-sm font-semibold">Fleet control centre</p>
            </div>
            <p class="text-xs text-cream/45">Illustrative view</p>
          </div>

          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            {[['Trucks on road', '23'], ['Avg. reefer temp', '3.0°C'], ['On-time today', '98%']].map(([k, v]) => (
              <div class="rounded-2xl bg-white/5 p-4">
                <p class="text-xs text-cream/50">{k}</p>
                <p class="display mt-1 text-3xl">{v}</p>
              </div>
            ))}
          </div>

          <div class="mt-4 rounded-2xl bg-white/5 p-4">
            <div class="flex items-center justify-between text-xs text-cream/55">
              <span>FP-RF 112 · reefer temperature</span>
              <span class="text-leaf">Within 2–4°C band</span>
            </div>
            <svg viewBox={`0 0 ${W} ${H}`} class="mt-3 h-24 w-full" preserveAspectRatio="none" aria-hidden="true">
              <rect x="0" y={band(4)} width={W} height={Number(band(2)) - Number(band(4))} fill="#6fae45" opacity=".12" />
              <path d={line} fill="none" stroke="#c9e6b4" stroke-width="2" vector-effect="non-scaling-stroke" />
            </svg>
          </div>

          <ul class="mt-4 divide-y divide-white/8 rounded-2xl bg-white/5 px-4 text-sm">
            {fleet.map((t) => (
              <li class="grid grid-cols-[1fr_auto] items-center gap-3 py-3 sm:grid-cols-[7rem_1fr_auto_auto]">
                <span class="font-semibold">{t.id}</span>
                <span class="hidden text-cream/60 sm:block">{t.route}</span>
                <span class={`rounded-full px-2.5 py-1 text-xs font-semibold ${t.ok ? 'bg-leaf/20 text-[#c9e6b4]' : 'bg-rose/25 text-blush'}`}>{t.temp}</span>
                <span class="hidden text-xs text-cream/50 sm:block">ETA {t.eta}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
