---
import Bloom from './Bloom.astro';
import Icon from './Icon.astro';
import { insights } from '../data/site';
const palettes: [string, string, string][] = [
  ['#7f1230', '#d8375c', '#ffb3c1'],
  ['#0f3329', '#1d4a3c', '#8fae9c'],
  ['#92400e', '#d6a645', '#fde68a'],
];
---

<section id="insights" class="py-24 lg:py-32">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <p class="eyebrow text-rose" data-reveal>Insights</p>
        <h2 class="display mt-5 text-4xl leading-[1.05] sm:text-5xl" data-reveal>Market intelligence for flower buyers.</h2>
      </div>
      <a href="#insights" class="btn-ghost shrink-0" data-reveal>View all insights <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {insights.map((post, i) => (
        <article class="group" data-reveal style={`--delay:${i * 80}ms`}>
          <a href="#insights" class="block">
            <div class="relative aspect-[16/10] overflow-hidden rounded-3xl" style={`background:${palettes[i][1]}`}>
              <Bloom palette={palettes[i]} seed={i + 7} size={300} class="absolute -right-10 -bottom-16 h-[120%] w-auto opacity-90 transition duration-[1.2s] ease-out-expo group-hover:scale-105 group-hover:rotate-6" />
              <span class="absolute top-5 left-5 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-ink">{post.tag}</span>
            </div>
            <div class="mt-5 flex items-center gap-3 text-xs text-ink/50"><span>{post.date}</span><span class="h-1 w-1 rounded-full bg-ink/30"></span><span>{post.read}</span></div>
            <h3 class="mt-2 text-xl leading-snug font-semibold transition group-hover:text-rose">{post.title}</h3>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
