import WhyUs from '../components/WhyUs.astro';
import Network from '../components/Network.astro';
import Quote from '../components/Quote.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <About />
    <Services />
    <Process />
    <Monitoring />
    <Industries />
    <WhyUs />
    <Network />
    <Quote />
